# ---------------------------------------------------------------------------
# PhishGuard - example environment file
#
# Copy this file to `.env` and adjust the values for your machine:
#
#     copy .env.example .env        (Windows cmd)
#     cp .env.example .env          (macOS / Linux)
#
# `.env` is git-ignored.  NEVER commit real credentials.
# ---------------------------------------------------------------------------

# -- Application -------------------------------------------------------------
APP_NAME="PhishGuard API"
APP_VERSION="1.0.0"
# development | staging | production
ENVIRONMENT=development
DEBUG=false

# -- Database ----------------------------------------------------------------
# SQLite (default, zero configuration):
DATABASE_URL=sqlite:///./phishguard.db
# PostgreSQL example (requires psycopg2):
# DATABASE_URL=postgresql+psycopg2://phishguard:change-me@localhost:5432/phishguard

# -- Model artifacts ---------------------------------------------------------
MODEL_PATH=ml/artifacts/phishguard_model.joblib
METRICS_PATH=ml/artifacts/model_metrics.json
MODEL_ARTIFACT_DIR=ml/artifacts

# -- Security ----------------------------------------------------------------
# Comma separated list of allowed browser origins for the dashboard.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
# Master switch for the per-IP rate limiter (disable only in tests).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
MAX_URL_LENGTH=2048

# -- Optional page analysis (SSRF protected) ---------------------------------
# Disabled by default: with page analysis off the scan path makes NO outbound
# network request at all, which removes the SSRF surface entirely.
PAGE_ANYSIS_ENABLED=false
PAGE_ANALYSIS_TIMEOUT=5.0
PAGE_ANALYSIS_MAX_BYTES=524288
PAGE_ANALYSIS_MAX_REDIRECTS=3
PAGE_ANALYSIS_ALLOWED_PORTS=80,443
# Never enable this outside a local lab: it disables the private-network block.
PAGE_ANALYSIS_ALLOW_PRIVATE_HOSTS=false

# -- Optional threat intelligence --------------------------------------------
# Disabled by default.  A provider failure NEVER means "safe" - the scan result
# is marked inconclusive instead.
THREAT_INTEL_ENABLED=false
THREAT_INTEL_PROVIDER=none
THREAT_INTEL_BLACKLIST_PATH=
THREAT_INTEL_TIMEOUT=5.0
# Explicit opt-in required before a submitted URL leaves this machine.
THREAT_INTEL_ALLOW_EXTERNAL_LOOKUP=false

# -- Retention ---------------------------------------------------------------
# Number of days a scan record is kept before the retention job removes it.
SCAN_RETENTION_DAYS=90
