# ---------------------------------------------------------------------------
# PhishGuard - ignore rules
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache
nosetests.xml

# Type checking / linting caches
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints

# Node / frontend
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Environment / secrets  (never commit real credentials)
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Local databases and runtime state
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/data/
data/
var/

# Model artifacts that are large or machine specific.
# The trained artifact and its metrics ARE tracked (they are the evidence for
# the reported results), but local scratch copies are not.
ml/artifacts/*.tmp
ml/artifacts/*.bak
ml/cache/

# Raw / intermediate datasets (re-downloadable, see ml/data/README.md)
ml/data/raw/
ml/data/interim/
ml/data/processed/
*.csv.gz

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.orig

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
